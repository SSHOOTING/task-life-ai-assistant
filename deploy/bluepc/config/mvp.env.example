# Goals of Ours MVP runtime configuration.
# Keep mock mode on the shared blue PC until key ownership is agreed.
LLM_MODE=mock
SQLITE_PATH=C:\GoalOfOurs\data\mvp.db

# Never commit a real key. If enabled later, inject it only in the deployed
# config file on the blue PC and change LLM_MODE to opencode.
# OPENCODE_API_KEY=
# OPENCODE_GO_MODEL=hy4-flash-free
# OPENCODE_GO_FALLBACK_MODEL=longcat-2.5-free
